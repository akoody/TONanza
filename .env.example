NODE_ENV=development
PORT=3000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tonanza
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tonanza?schema=public"
FRONTEND_URL="https://tonanza.online"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

ROUND_DURATION_SECONDS=40
GAME_RAKE_BPS=400
MIN_BET_NANOTONS=100000000
DEV_BOOTSTRAP_BALANCE_NANOTONS=100000000000

APP_WALLET_ADDRESS="EQXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
APP_WALLET_MNEMONIC=""
TONCENTER_BASE_URL="https://toncenter.com/api/v2/jsonRPC"
TONCENTER_API_KEY=""

WATCHER_POLL_INTERVAL_MS=12000
WATCHER_POLL_BATCH_SIZE=50
WATCHER_POLL_MAX_PAGES=12
WATCHER_CATCHUP_MAX_PAGES=60
WATCHER_LOCK_TTL_MS=60000
WATCHER_RECOVER_FAILED_LIMIT=100

TRUST_PROXY_HEADERS=false
SOCKET_MAX_HTTP_BUFFER_SIZE=16384

HTTP_RATE_LIMIT_ENABLED=true
HTTP_RATE_LIMIT_WINDOW_MS=60000
HTTP_RATE_LIMIT_MAX_REQUESTS=240
HTTP_RATE_LIMIT_BLOCK_MS=120000
HTTP_RATE_LIMIT_STATE_TTL_MS=3600000

SOCKET_CONNECT_RATE_LIMIT_ENABLED=true
SOCKET_CONNECT_RATE_WINDOW_MS=60000
SOCKET_CONNECT_RATE_MAX_ATTEMPTS=40
SOCKET_CONNECT_RATE_BLOCK_MS=180000
SOCKET_CONNECT_RATE_STATE_TTL_MS=3600000

SOCKET_EVENT_RATE_LIMIT_ENABLED=true
SOCKET_EVENT_RATE_WINDOW_MS=10000
SOCKET_EVENT_RATE_MAX_EVENTS=120
SOCKET_EVENT_RATE_BLOCK_MS=30000
SOCKET_EVENT_RATE_STATE_TTL_MS=3600000

CHAT_ENABLED=true
CHAT_COOLDOWN_MS=10000
CHAT_MAX_MESSAGE_LENGTH=160
CHAT_HISTORY_LIMIT=100
CHAT_BUCKET_CAPACITY=3
CHAT_BUCKET_WINDOW_MS=60000
CHAT_AUTO_MUTE_MS=120000
CHAT_ADMIN_USER_IDS=""
