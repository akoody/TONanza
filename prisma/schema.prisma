generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DealRole {
  BUYER
  SELLER
}

enum DealStatus {
  OPEN
  WAITING_PAYMENT
  IN_PROGRESS
  CLOSED
}

enum DealParticipantRole {
  OWNER
  MEMBER
  ADMIN
}

enum ChatMessageKind {
  TEXT
  PHOTO
  SYSTEM
  REQUISITES
  NOTIFICATION
}

model User {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  telegramId BigInt   @unique @map("telegram_id") @db.BigInt
  username   String?  @db.VarChar(64)
  firstName  String?  @map("first_name") @db.VarChar(128)
  lastName   String?  @map("last_name") @db.VarChar(128)
  avatarUrl  String?  @map("avatar_url") @db.VarChar(512)
  isAdmin    Boolean  @default(false) @map("is_admin")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  ownedDeals    Deal[]            @relation("DealOwner")
  participants  DealParticipant[]
  messages      ChatMessage[]

  @@map("users")
}

model Deal {
  id          BigInt     @id @default(autoincrement()) @db.BigInt
  code        String     @unique @db.VarChar(12)
  title       String     @db.VarChar(120)
  terms       String     @db.VarChar(2000)
  ownerRole   DealRole   @map("owner_role")
  amountCents Int        @map("amount_cents")
  status      DealStatus @default(OPEN)
  ownerId     BigInt     @map("owner_id") @db.BigInt
  closedAt    DateTime?  @map("closed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  owner        User              @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  participants DealParticipant[]
  messages     ChatMessage[]

  @@index([title])
  @@index([status, createdAt])
  @@map("deals")
}

model DealParticipant {
  id        BigInt              @id @default(autoincrement()) @db.BigInt
  dealId    BigInt              @map("deal_id") @db.BigInt
  userId    BigInt              @map("user_id") @db.BigInt
  role      DealParticipantRole
  createdAt DateTime            @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dealId, userId])
  @@index([userId])
  @@map("deal_participants")
}

model ChatMessage {
  id        BigInt          @id @default(autoincrement()) @db.BigInt
  dealId    BigInt          @map("deal_id") @db.BigInt
  userId    BigInt?         @map("user_id") @db.BigInt
  kind      ChatMessageKind @default(TEXT)
  text      String?         @db.VarChar(2000)
  photoUrl  String?         @map("photo_url") @db.VarChar(512)
  createdAt DateTime        @default(now()) @map("created_at")

  deal Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([dealId, createdAt])
  @@map("chat_messages")
}
